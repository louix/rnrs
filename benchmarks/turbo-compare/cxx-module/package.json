{
  "name": "@rnrs-bench/cmp-cxx",
  "version": "0.1.0",
  "private": true,
  "description": "Benchmark-only RN codegen C++ TurboModule for the rnrs comparison (benchmarks/turbo-compare). Not a product module.",
  "license": "MIT",
  "main": "specs/NativeRnrsCmpCxx.ts",
  "types": "specs/NativeRnrsCmpCxx.ts",
  "react-native": "specs/NativeRnrsCmpCxx.ts",
  "files": [
    "specs",
    "cpp",
    "android/CMakeLists.txt",
    "ios",
    "RnrsCmpCxx.podspec",
    "react-native.config.js"
  ],
  "codegenConfig": {
    "name": "RnrsCmpCxxSpec",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "dev.rustjsilab.rnrscmp"
    },
    "ios": {
      "modulesProvider": {
        "RnrsCmpCxx": "RnrsCmpCxxProvider"
      }
    }
  },
  "peerDependencies": {
    "react-native": "0.88.0"
  }
}
