{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error"
  },
  "overrides": [
    {
      "files": ["fixtures/bevy-worklets/App.tsx", "fixtures/worklets-lab/GestureLab.tsx"],
      "rules": { "react/immutability": "off" }
    },
    {
      "files": ["fixtures/surface-s3/App.tsx"],
      "rules": { "react/set-state-in-effect": "off" }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.generated/**",
    "**/.rnrs/**",
    "**/generator/**",
    "**/build/**",
    "**/dist/**",
    "**/target/**",
    "**/vendor/**",
    "**/bundle/**",
    "**/archive/**",
    "**/archives/**",
    ".project-notes/**",
    "results/**",
    "docs/research/**",
    "react-native/**",
    "**/*.min.js",
    "packages/*/rnrs/**",
    "packages/fixtures/*/rnrs/**",
    "apps/lab/web/rnrs/**",
    "fixtures/*/rnrs/**",
    "**/package-lock.json",
    "**/Cargo.lock",
    "**/*.Cargo.lock"
  ]
}
