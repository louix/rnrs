{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.generated/**",
    "**/.rnr/**",
    "**/generator/**",
    "**/build/**",
    "**/dist/**",
    "**/target/**",
    "**/vendor/**",
    "**/bundle/**",
    "**/archive/**",
    "**/archives/**",
    ".project-notes/**",
    "results/**",
    "docs/research/**",
    "react-native/**",
    "**/*.min.js",
    "packages/*/rnr/**",
    "packages/fixtures/*/rnr/**",
    "web/rnr/**",
    "fixtures/*/rnr/**",
    "**/package-lock.json",
    "**/Cargo.lock",
    "**/*.Cargo.lock"
  ]
}
