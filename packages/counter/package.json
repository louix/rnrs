{
  "name": "@rnrs/example-counter",
  "version": "0.4.0",
  "private": true,
  "description": "Mutable Rust counter with synchronous and cancellable async methods.",
  "license": "MIT",
  "rustNative": {
    "targets": [
      "android",
      "ios",
      "web"
    ],
    "spec": "counter.spec.ts",
    "rust": {
      "crate": "counter",
      "path": "rust",
      "module": "Module"
    },
    "maxInFlight": 8
  },
  "files": [
    "counter.spec.ts",
    "rust/Cargo.toml",
    "rust/src",
    "rnrs"
  ],
  "main": "rnrs/index.ts",
  "types": "rnrs/index.ts",
  "react-native": "rnrs/index.ts",
  "browser": "rnrs/web.ts",
  "exports": {
    ".": {
      "types": "./rnrs/index.ts",
      "browser": "./rnrs/web.ts",
      "default": "./rnrs/index.ts"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@rnrs/runtime": "0.4.0"
  }
}
