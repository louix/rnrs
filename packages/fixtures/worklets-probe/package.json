{
  "name": "@rnrs/labs-worklets-probe",
  "version": "0.1.0",
  "private": true,
  "description": "Lab-only fixture for the Worklets proof of concept: scalar sync methods, one native object, and shapes the worklet endpoint refuses.",
  "rustNative": {
    "targets": [
      "android"
    ],
    "spec": "worklets-probe.spec.ts",
    "rust": {
      "crate": "worklets-probe",
      "path": "rust",
      "module": "Module"
    },
    "maxInFlight": 4
  },
  "files": [
    "worklets-probe.spec.ts",
    "rust/Cargo.toml",
    "rust/src",
    "rnr"
  ],
  "main": "rnr/index.ts",
  "types": "rnr/index.ts",
  "react-native": "rnr/index.ts",
  "exports": {
    ".": {
      "types": "./rnr/index.ts",
      "default": "./rnr/index.ts"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@rnrs/runtime": "0.1.0"
  },
  "license": "UNLICENSED"
}
