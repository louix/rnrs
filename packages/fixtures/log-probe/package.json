{
  "name": "@rnrs/labs-log-probe",
  "version": "0.2.0",
  "private": true,
  "description": "Lab-only fixture for the Rust logging smoke: emits tracing events and log records on the JS thread and on a worker thread.",
  "license": "MIT",
  "rustNative": {
    "targets": [
      "android",
      "ios",
      "web"
    ],
    "spec": "log-probe.spec.ts",
    "rust": {
      "crate": "log-probe",
      "path": "rust",
      "module": "Module"
    },
    "maxInFlight": 4
  },
  "files": [
    "log-probe.spec.ts",
    "rust/Cargo.toml",
    "rust/src",
    "rnrs"
  ],
  "main": "rnrs/index.ts",
  "types": "rnrs/index.ts",
  "react-native": "rnrs/index.ts",
  "browser": "rnrs/web.ts",
  "exports": {
    ".": {
      "types": "./rnrs/index.ts",
      "browser": "./rnrs/web.ts",
      "default": "./rnrs/index.ts"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@rnrs/runtime": "0.2.0"
  }
}
