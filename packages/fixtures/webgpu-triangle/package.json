{
  "name": "@rnrs/labs-webgpu-triangle",
  "version": "0.4.0",
  "private": true,
  "description": "Lab fixture: one wgpu triangle drawn by Rust through the rnrs wgpu adapter into an @rnrs/surface view (Android: Vulkan, iOS: Metal, browser: WebGPU). No fallback.",
  "license": "MIT",
  "rustNative": {
    "targets": [
      "android",
      "ios",
      "web"
    ],
    "spec": "webgpu-triangle.spec.ts",
    "rust": {
      "crate": "rnrs-webgpu-triangle",
      "path": "rust",
      "module": "Module"
    }
  },
  "files": [
    "webgpu-triangle.spec.ts",
    "rust/Cargo.toml",
    "rust/src",
    "rnrs"
  ],
  "main": "rnrs/index.ts",
  "types": "rnrs/index.ts",
  "browser": "rnrs/web.ts",
  "exports": {
    ".": {
      "types": "./rnrs/index.ts",
      "browser": "./rnrs/web.ts",
      "default": "./rnrs/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@rnrs/surface": "0.4.0"
  },
  "peerDependencies": {
    "@rnrs/runtime": "0.4.0"
  }
}
