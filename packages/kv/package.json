{
  "name": "@rnrs/example-kv",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent key-value store for React Native on Android and iOS, implemented in Rust with sled. No browser backend. Experimental.",
  "rustNative": {
    "targets": [
      "android",
      "ios"
    ],
    "spec": "kv.spec.ts",
    "rust": {
      "crate": "rnrs-kv",
      "path": "rust",
      "module": "Kv"
    },
    "maxInFlight": 32
  },
  "files": [
    "kv.spec.ts",
    "rust/Cargo.toml",
    "rust/src",
    "rnrs"
  ],
  "main": "rnrs/index.ts",
  "types": "rnrs/index.ts",
  "react-native": "rnrs/index.ts",
  "browser": "rnrs/web.ts",
  "exports": {
    ".": {
      "types": "./rnrs/index.ts",
      "browser": "./rnrs/web.ts",
      "default": "./rnrs/index.ts"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@rnrs/runtime": "0.1.0"
  },
  "license": "UNLICENSED"
}
