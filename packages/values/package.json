{
  "name": "@rnrs/labs-values",
  "version": "0.4.0",
  "private": true,
  "description": "Pass records, unions, dictionaries, buffers, JSON and typed errors between TypeScript and Rust.",
  "license": "MIT",
  "rustNative": {
    "targets": [
      "android",
      "ios",
      "web"
    ],
    "spec": "values.spec.ts",
    "rust": {
      "crate": "values",
      "path": "rust",
      "module": "Values"
    },
    "maxInFlight": 8
  },
  "files": [
    "values.spec.ts",
    "rust/Cargo.toml",
    "rust/src",
    "rnrs",
    "shared.ts"
  ],
  "main": "rnrs/index.ts",
  "types": "rnrs/index.ts",
  "react-native": "rnrs/index.ts",
  "browser": "rnrs/web.ts",
  "exports": {
    ".": {
      "types": "./rnrs/index.ts",
      "browser": "./rnrs/web.ts",
      "default": "./rnrs/index.ts"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@rnrs/runtime": "0.4.0"
  }
}
