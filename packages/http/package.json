{
  "name": "@rnrs/example-http",
  "version": "0.3.0",
  "private": true,
  "description": "HTTP client for React Native (Android and iOS, reqwest on Tokio) and browser Wasm (reqwest over fetch), implemented in Rust. Experimental.",
  "license": "MIT",
  "rustNative": {
    "targets": [
      "android",
      "ios",
      "web"
    ],
    "spec": "http.spec.ts",
    "rust": {
      "crate": "rnrs-http",
      "path": "rust",
      "module": "Http"
    },
    "maxInFlight": 16
  },
  "files": [
    "http.spec.ts",
    "rust/Cargo.toml",
    "rust/src",
    "rnrs"
  ],
  "main": "rnrs/index.ts",
  "types": "rnrs/index.ts",
  "react-native": "rnrs/index.ts",
  "browser": "rnrs/web.ts",
  "exports": {
    ".": {
      "types": "./rnrs/index.ts",
      "browser": "./rnrs/web.ts",
      "default": "./rnrs/index.ts"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@rnrs/runtime": "0.3.0"
  }
}
