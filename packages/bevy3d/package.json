{
  "name": "@rnrs/example-bevy3d",
  "version": "0.4.0",
  "private": true,
  "description": "Bevy cube controlled from TypeScript and displayed with rnrs-surface. Requires Rust 1.97.1 and Android API 26; iOS and browser rendering are experimental. See README.md.",
  "license": "MIT",
  "rustNative": {
    "targets": [
      "android",
      "ios",
      "web"
    ],
    "spec": "bevy3d.spec.ts",
    "rust": {
      "crate": "rnrs-bevy3d",
      "path": "rust",
      "module": "Module"
    }
  },
  "files": [
    "bevy3d.spec.ts",
    "rust/Cargo.toml",
    "rust/src",
    "rnrs"
  ],
  "main": "rnrs/index.ts",
  "types": "rnrs/index.ts",
  "react-native": "rnrs/index.ts",
  "exports": {
    ".": {
      "types": "./rnrs/index.ts",
      "default": "./rnrs/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@rnrs/surface": "0.4.0"
  },
  "peerDependencies": {
    "@rnrs/runtime": "0.4.0"
  }
}
