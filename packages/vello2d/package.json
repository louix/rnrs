{
  "name": "@rnrs/example-vello2d",
  "version": "0.4.0",
  "private": true,
  "description": "Draw TypeScript frames with Vello's CPU rasterizer on Android, iOS and the browser. Experimental.",
  "license": "MIT",
  "rustNative": {
    "targets": [
      "android",
      "ios",
      "web"
    ],
    "spec": "vello2d.spec.ts",
    "rust": {
      "crate": "rnrs-vello2d",
      "path": "rust",
      "module": "Module"
    }
  },
  "files": [
    "vello2d.spec.ts",
    "frame.ts",
    "rust/Cargo.toml",
    "rust/src",
    "rnrs"
  ],
  "main": "rnrs/index.ts",
  "types": "rnrs/index.ts",
  "react-native": "rnrs/index.ts",
  "exports": {
    ".": {
      "types": "./rnrs/index.ts",
      "default": "./rnrs/index.ts"
    },
    "./frame": {
      "types": "./frame.ts",
      "default": "./frame.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@rnrs/surface": "0.4.0"
  },
  "peerDependencies": {
    "@rnrs/runtime": "0.4.0"
  }
}
