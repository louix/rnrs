{
  "name": "@rnrs/labs-bench",
  "version": "0.4.0",
  "private": true,
  "description": "Measurement-only module for the conversion pilot. Not a product module.",
  "license": "MIT",
  "rustNative": {
    "targets": [
      "android",
      "ios",
      "web"
    ],
    "spec": "bench.spec.ts",
    "rust": {
      "crate": "rnrs-bench",
      "path": "rust",
      "module": "Bench"
    },
    "maxInFlight": 64
  },
  "files": [
    "bench.spec.ts",
    "rust/Cargo.toml",
    "rust/src",
    "rnrs"
  ],
  "main": "rnrs/index.ts",
  "types": "rnrs/index.ts",
  "react-native": "rnrs/index.ts",
  "browser": "rnrs/web.ts",
  "exports": {
    ".": {
      "types": "./rnrs/index.ts",
      "browser": "./rnrs/web.ts",
      "default": "./rnrs/index.ts"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@rnrs/runtime": "0.4.0"
  }
}
