{
  "name": "@rnrs/labs-meter",
  "version": "0.1.0",
  "private": true,
  "description": "Meter module: second generator fixture. Rust implementation in rust/meter.",
  "rustNative": {
    "targets": [
      "android",
      "ios",
      "web"
    ],
    "spec": "meter.spec.ts",
    "rust": {
      "crate": "meter",
      "path": "rust",
      "module": "Meter"
    },
    "maxInFlight": 4
  },
  "files": [
    "meter.spec.ts",
    "rust/Cargo.toml",
    "rust/src",
    "rnr"
  ],
  "main": "rnr/index.ts",
  "types": "rnr/index.ts",
  "react-native": "rnr/index.ts",
  "browser": "rnr/web.ts",
  "exports": {
    ".": {
      "types": "./rnr/index.ts",
      "browser": "./rnr/web.ts",
      "default": "./rnr/index.ts"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@rnrs/runtime": "0.1.0"
  },
  "license": "UNLICENSED"
}
