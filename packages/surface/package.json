{
  "name": "@rnrs/surface",
  "version": "0.2.0",
  "description": "Experimental framework rendering surface for React Native (Android, iOS): the <RnrsSurfaceView> Fabric component and the rnrs-surface Rust crate that renderer modules depend on. Platform glue is framework code; renderer authors write TypeScript and Rust only.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louix/rnrs.git",
    "directory": "packages/surface"
  },
  "homepage": "https://github.com/louix/rnrs/tree/main/packages/surface#readme",
  "bugs": {
    "url": "https://github.com/louix/rnrs/issues"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "browser": "./src/index.web.tsx",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./browser": {
      "types": "./src/browser/bootstrap.ts",
      "default": "./src/browser/bootstrap.ts"
    }
  },
  "rustNative": {
    "targets": [
      "android",
      "ios",
      "web"
    ],
    "library": {
      "crate": "rnrs-surface",
      "path": "rust"
    }
  },
  "codegenConfig": {
    "name": "RnrsSurfaceSpec",
    "type": "components",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "dev.rustjsilab.rnrs.surface"
    },
    "ios": {
      "componentProvider": {
        "RnrsSurfaceView": "RnrsSurfaceViewComponentView"
      }
    }
  },
  "files": [
    "src",
    "rust/Cargo.toml",
    "rust/src",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "android/src",
    "react-native.config.js",
    "ios",
    "RnrsSurface.podspec"
  ],
  "peerDependencies": {
    "@rnrs/runtime": "0.2.0",
    "react": "^19.3.0",
    "react-native": "^0.88.0"
  },
  "browser": "src/index.web.tsx",
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  }
}
