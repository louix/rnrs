{
  "name": "rust-jsi-lab",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "lint": "oxlint --deny-warnings src specs packages scripts tools fixtures web *.js",
    "lint:fix": "npm run lint -- --fix",
    "fmt": "oxfmt --write \"{src,specs,packages,scripts,tools,fixtures,web}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\" \"*.js\" package.json .oxfmtrc.json .oxlintrc.json renovate.json",
    "fmt:check": "oxfmt --check \"{src,specs,packages,scripts,tools,fixtures,web}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\" \"*.js\" package.json .oxfmtrc.json .oxlintrc.json renovate.json",
    "start": "react-native start",
    "android": "react-native run-android",
    "test": "node --test scripts/*.test.mjs tools/rnr-gen/test/*.test.mjs",
    "test:rnrs-offline": "cargo fetch --locked && RNR_REQUIRE_CARGO=1 node --test tools/rnr-gen/test/rnrs-offline.test.mjs",
    "typecheck": "node tools/rnr-gen/cli.mjs generate && tsc --noEmit && node scripts/typecheck-ios-fixture.mjs",
    "summarize": "node scripts/summarize.mjs",
    "rnr:gen": "node tools/rnr-gen/cli.mjs generate",
    "rnr:check": "node tools/rnr-gen/cli.mjs check"
  },
  "codegenConfig": {
    "name": "LabSpecs",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "com.helloworld"
    }
  },
  "dependencies": {
    "@rnrs/cli": "file:packages/rnr-cli",
    "@rnrs/example-blake3": "file:packages/blake3",
    "@rnrs/example-counter": "file:packages/counter",
    "@rnrs/example-http": "file:packages/http",
    "@rnrs/example-kv": "file:packages/kv",
    "@rnrs/labs-bench": "file:packages/bench",
    "@rnrs/labs-meter": "file:packages/meter",
    "@rnrs/labs-values": "file:packages/values",
    "@rnrs/runtime": "file:packages/rnr-runtime",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@types/react": "19.3.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "smol-toml": "1.9.0",
    "typescript": "6.0.3"
  },
  "rustNativeApp": {
    "packages": [
      "packages/counter",
      "packages/meter",
      "packages/values",
      "packages/blake3",
      "packages/http",
      "packages/kv",
      "packages/bench"
    ]
  }
}
