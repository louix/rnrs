{
  "name": "rust-jsi-lab",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/lab"
  ],
  "scripts": {
    "lint": "oxlint --deny-warnings apps packages scripts tools fixtures",
    "lint:fix": "npm run lint -- --fix",
    "fmt": "oxfmt --write \"{apps,packages,scripts,tools,fixtures}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\" package.json apps/lab/package.json .oxfmtrc.json .oxlintrc.json renovate.json",
    "fmt:check": "oxfmt --check \"{apps,packages,scripts,tools,fixtures}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\" package.json apps/lab/package.json .oxfmtrc.json .oxlintrc.json renovate.json",
    "start": "npm run start -w apps/lab --",
    "android": "npm run android -w apps/lab --",
    "test": "node --test scripts/*.test.mjs tools/rnrs-gen/test/*.test.mjs",
    "test:rnrs-offline": "cargo fetch --locked && RNRS_REQUIRE_CARGO=1 node --test tools/rnrs-gen/test/rnrs-offline.test.mjs",
    "typecheck": "node tools/rnrs-gen/cli.mjs generate && node node_modules/typescript/bin/tsc --noEmit && node scripts/typecheck-ios-fixture.mjs",
    "rnrs:gen": "node tools/rnrs-gen/cli.mjs generate",
    "rnrs:check": "node tools/rnrs-gen/cli.mjs check"
  },
  "dependencies": {
    "@rnrs/cli": "file:packages/cli"
  },
  "devDependencies": {
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@types/react": "19.3.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "smol-toml": "1.9.0",
    "typescript": "7.0.2",
    "typescript6": "npm:typescript@6.0.3"
  },
  "rustNativeApp": {
    "packages": [
      "packages/counter",
      "packages/meter",
      "packages/values",
      "packages/blake3",
      "packages/http",
      "packages/kv",
      "packages/bench"
    ]
  }
}
